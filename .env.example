# Copy to server/.env for local runs (npm run dev:server reads it). In production set these in the platform's settings.
PORT=3000
LOG_LEVEL=info
# comma-separated list of page origins allowed to open the WebSocket (empty = localhost only)
ALLOWED_ORIGINS=
MAX_CONNECTIONS_PER_IP=8
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=8
# true behind a reverse proxy (Render, Fly.io, Caddy) so the client IP comes from X-Forwarded-For
TRUST_PROXY=false
# secrets (never commit real values): none required yet. Example for error tracking:
# SENTRY_DSN=
